# Copie para backend/.env e preencha. O arquivo .env não vai para o Git.
FAUNA_DB_HOST=localhost
FAUNA_DB_PORT=5432
FAUNA_DB_NAME=fauna_urbana
FAUNA_DB_USER=fauna_app
FAUNA_DB_PASSWORD=troque-esta-senha

# Origens que podem chamar a API (separadas por vírgula). "*" libera todas.
FAUNA_CORS_ORIGINS=*

# Painel administrativo (veja auth.py). Gere o hash com: python auth.py "senha"
FAUNA_ADMIN_USUARIO=admin
FAUNA_ADMIN_SENHA_HASH=
FAUNA_SECRET_KEY=troque-por-um-texto-aleatorio-longo
